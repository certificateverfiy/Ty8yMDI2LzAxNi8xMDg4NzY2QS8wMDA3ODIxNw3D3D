function INSIGHTBreadcrumb(){
	$('title').html('Inregrated Support for Trade Intelligence & Facilitation (INSIGHT)');
	$('.template-title').html('Inregrated Support for Trade Intelligence & Facilitation (INSIGHT)');
	$('.template-desc').html('The initiative facilitates exporter preparedness and export-support ecosystems by addressing information asymmetries, procedural frictions, and institutional capacity gaps faced by exporters and export-support entities, with particular emphasis on Micro, Small and Medium Enterprises (MSMEs).');
	
