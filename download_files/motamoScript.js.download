function InterestExportCreditBreadcrumb(){
	$('title').html('Interest Subvention Support for Pre-and Post-Shipment Export Credit');
	$('.template-title').html('Interest Subvention Support for Pre-and Post-Shipment Export Credit');
	$('.template-desc').html('The initiative facilitates improved access to pre- and post-shipment rupee export credit for MSME exporters by reducing the cost of such credit.');
	
	var bannerImg = 'https://content.trade.gov.in/TCP_LANDING_PAGE_IMG/MAI_BG.jpg';
	$('.template-head-section').css({background: "linear-gradient(124deg, rgba(21, 29, 76, 1), rgba(48, 50, 100, 1), rgba(170, 174, 199, .4)) fixed, url(" + bannerImg + ")"});
	matomo();
}
