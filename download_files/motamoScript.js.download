function GLOBALbreadcrumb(){
	$('title').html('Global Outreach for Branding, Labelling and Export Packaging (GLOBE)');
	$('.template-title').html('Global Outreach for Branding, Labelling and Export Packaging (GLOBE)');
	$('.template-desc').html('The intervention seeks to strengthen ‘Unified Indian Brand’ in global markets by establishing a coordinated National Brand India Framework with a multi-tier Trust Mark certification system to enhance global brand identity and positioning for Indian products and services transforming India from a commodity exporter to brand exporter and strengthening India’s soft power in international trade. The initiative will be implemented through periodical identification of priority sectors, product categories, or markets.');
	
	var bannerImg = 'https://content.trade.gov.in/TCP_LANDING_PAGE_IMG/MAI_BG.jpg';
	$('.template-head-section').css({background: "linear-gradient(124deg, rgba(21, 29, 76, 1), rgba(48, 50, 100, 1), rgba(170, 174, 199, .4)) fixed, url(" + bannerImg + ")"});
	matomo();
}
function NTBbreadcrumb(){
	$('title').html('Non-Tariff Barriers');
	$('.template-title').html('Non-Tariff Barriers');
	$('.template-desc').html('Non-Tariff Barrier module is a targeted initiative to support Indian exporters in addressing non-tariff barriers in foreign markets and enhancing market access opportunities. It provides a platform for exporters to report non-tariff barriers, enabling swift government intervention, improved market access, and data-driven trade facilitation.');
	
	var bannerImg = 'https://content.trade.gov.in/TCP_LANDING_PAGE_IMG/MAI_BG.jpg';
	$('.template-head-section').css({background: "linear-gradient(124deg, rgba(21, 29, 76, 1), rgba(48, 50, 100, 1), rgba(170, 174, 199, .4)) fixed, url(" + bannerImg + ")"});
	matomo();
}