function maiBreadcrumb(){
	$('title').html('Market Access Support');
	$('.template-title').html('Market Access Support');
	$('.template-desc').html('<p class="mb-0">The Market Access Support is a targeted and outcome-oriented programme to enhance export competitiveness of Indian exporters. It provides financial support for a defined set of market-development activities, including participation in international fairs and Buyer Seller Meets (BSM), conducting Reverse Buyer Seller Meets (RBSM). It also supports focused trade delegations, and proof-of-concept demonstrations in priority and emerging markets. The initiative leverages a digital workflow for improving transparency and ensuring evidence-based decision making.</p><p class="mb-0">Eligible organisations and valid IEC holders can apply for support under the Market Access Support on Trade Connect ePlatform.</p>');
	$('.template-desc').addClass('w-100');
	var bannerImg = 'https://content.trade.gov.in/TCP_LANDING_PAGE_IMG/MAI_BG.jpg';
	$('.template-head-section').css({background: "linear-gradient(124deg, rgba(21, 29, 76, 1), rgba(48, 50, 100, 1), rgba(170, 174, 199, .4)) fixed, url(" + bannerImg + ")"});
	matomo();
}

